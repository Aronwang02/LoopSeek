# Copy to run.env (not in git) and fill in the paths; run.sh and scripts/*.sh source it.

# --- environment (bash run.sh setup) ---
ENV_NAME=jev_fa                    # conda env of System I (setup creates it)
TORCH_CUDA=cu126                   # torch 2.14.0 + CUDA 12.6 wheels
# FLASH_ATTN_WHEEL=/path/to/flash_attn-2.8.3.whl        # optional; default: a pinned prebuilt wheel
# CAUSAL_CONV1D_WHEEL=/path/to/causal_conv1d-1.7.0.whl  # optional; default: compiled from source
export HF_HOME=/path/to/hf_cache   # OneJev-4B, Qwen3-VL-8B and the LoopSeek adapters (~40 GB)
# VLLM_PYTHON=/path/to/vllm_env/bin/python   # System II's vLLM environment; setup creates .venv-vllm when unset
# export HF_TOKEN=...              # MLVU and LongVideoBench are gated: accept their terms on Hugging Face first

# --- data (bash run.sh data) ---
DATA=/path/to/eval_data            # the five benchmarks' videos and manifests (about 600 GB)
CGB_ROOT=/path/to/cgbench          # CG-Bench (about 350 GB; CG-Bench mini needs it); reused when already prepared

# --- GPUs ---
# One inference process per entry of GPUS; the processes share one question queue.
#   GPUS="0 1 2 3"      one GPU each (80 GB or more): System I and System II share it
#   GPUS="0,1 2,3"      two GPUs each (configs/two_gpu.yaml): System I on the first, System II on the second (40-48 GB)
GPUS="0 1 2 3 4 5 6 7"
BATCH_QUESTIONS=8                  # questions in flight per process; 4 if System I runs out of GPU memory
