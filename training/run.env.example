# Copy to run.env (not in git) and fill in the paths; run.sh sources it.
# The values below are the settings of the paper's System I training (8 GPUs).

# --- environment (bash run.sh setup) ---
ENV_NAME=jev_fa
TORCH_CUDA=cu126                   # torch 2.14.0 + CUDA 12.6 wheels
# FLASH_ATTN_WHEEL=/path/to/flash_attn-2.8.3.whl        # optional; default: a pinned prebuilt wheel
# CAUSAL_CONV1D_WHEEL=/path/to/causal_conv1d-1.7.0.whl  # optional; default: compiled from source
# JEV_CUDA_FORCE_BUILD=1           # optional: compile both CUDA extensions
export HF_HOME=/path/to/hf_cache   # model snapshots (~35 GB)
# VLLM_PYTHON=/path/to/vllm_env/bin/python   # the answerer's vLLM environment; setup creates one when unset

# --- data ---
# CG-Bench (Hugging Face dataset CG-Bench/CG-Bench): scripts/prepare_cgbench.py
CGB_JSON=/path/to/cgbench.json
CGB_MINI=/path/to/cgbench_mini.json
CGB_VIDEOS=/path/to/cgbench_videos           # <video_uid>.mp4
# LV-Haystack (Ego4D videos): scripts/prepare_lvhaystack.py --root "$LVH_ROOT" --download
# (the Ego4D downloader needs Ego4D-issued keys under [ego4d] in ~/.aws/credentials)
LVH_TRAIN=1
LVH_ROOT=/path/to/lvhaystack
LVH_VIDEOS=/path/to/lvhaystack/ego4d/v2/full_scale
LVH_TAU=2
LVH_DEV_VIDEOS=50
# VideoITG-40K short videos, trained as a second profile (configs/short.yaml)
SHORT_VIDEO=1
SHORT_SOURCE=videoitg
VIDEOITG_JSON=/path/to/video_itg_data.json
VIDEOITG_VIDEOS=/path/to/videoitg_videos     # the directory that holds LLaVA-Video-178K/
VIDEOITG_MULTI_SEGMENT=1
VIDEOITG_POOL=all                  # every VideoITG train question goes to the filter (the paper's data)
VIDEOITG_DEV_LIMIT=300             # dev questions, drawn by duration category (VIDEOITG_BINS, seeded)
VTS_READER_BATCH_SIZE=2            # System II's batch in the question filter, as for the paper's data
# PREPARED_DATA=1                  # the filtered manifests exist already: skip the data step

# --- run ---
GPUS="0 1 2 3 4 5 6 7"             # collection: one shard per GPU
SFT_GPUS=all                       # SFT on every GPU of GPUS (torchrun)
CFG="configs/default.yaml configs/train_8gpu.yaml"
TAG=loopseek_system1               # run-name prefix; a new TAG starts a new experiment, the same TAG resumes

# --- training recipe ---
DAGGER_ROUNDS=1
BETA=0.3                           # DAgger: probability that the expert acts
INJECT_WRONG=0.3                   # s3 / s5 / DAgger collections: probability of a wrong window per locator call
INJECT_MAX=2
INJECT_MIN_PROB=0.05
SFT_EPOCHS=1
SFT_FIT_N=64                       # overfit check on 64 decisions before grounding1, verifier1 and controller0
SFT_FIT_STEPS=100
SFT_EARLY_STOP_PATIENCE=2          # dev evaluations without improvement (sft.eval_every steps apart)
SFT_EARLY_STOP_MIN_DELTA=0.0
VERIFIER_BALANCE=1                 # class-balanced verifier rows and dev metric
VERIFIER_BALANCE_CLIP=4
COLLECT_BATCH_QUESTIONS=8

# --- wandb (your own account; `wandb login` once) ---
export WANDB_ENTITY=your-wandb-user-or-team
export WANDB_PROJECT=loopseek
export WANDB_MODE=online

# --- shared machines (optional): every GPU step reserves this much memory; JEV_HOLD=1 keeps it between steps ---
# JEV_RESERVE_GB=110
# JEV_HOLD=1
